/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "personal-ai-os",

  "main": "worker/index.ts",

  "compatibility_date": "2026-10-19",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-ai-os-db",
      "database_id": "3f9305ea-cc7b-47bc-ac11-07faff106096",
      "migrations_dir": "migrations"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "vars": {
    "HEALTHCHECKS_PING_URL": "",
    "AI_PROVIDER_ORDER": "groq_primary,groq_secondary,gemini_primary,workers_ai",
    "GEMINI_ENABLED": "1",
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "GROQ_MODEL_SECONDARY": "openai/gpt-oss-20b",
    "GEMINI_MODEL": "gemini-2.0-flash",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.2-3b-instruct",
    "WEBHOOK_URL": "https://personal-ai-os.jatin-personal-ai.workers.dev/api/v1/telegram/webhook"
  },

  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true
}