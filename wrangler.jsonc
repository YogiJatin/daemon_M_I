/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "personal-ai-os",

  "main": "worker/index.ts",

  "compatibility_date": "2026-10-19",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-ai-os-db",
      "database_id": "3f9305ea-cc7b-47bc-ac11-07faff106096",
      "migrations_dir": "migrations"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "vars": {
    "HEALTHCHECKS_PING_URL": "",
    "AI_PROVIDER_ORDER": "groq_primary,groq_secondary,workers_ai",
    "GROQ_MODEL": "llama-3.3-70b-versatile",
    "GROQ_MODEL_SECONDARY": "llama-3.1-8b-instant",
    "GEMINI_MODEL": "gemini-2.0-flash",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast"
  },

  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true
}