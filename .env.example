# Personal AI OS - environment variable NAMES only.
#
# Never put real values in this file. It is committed.
# Local development values go in .dev.vars (gitignored, read by wrangler dev).
# Production values are Worker secrets set with: npx wrangler secret put NAME
#
# Secret scanning (Gitleaks) runs in CI, so a real key committed here fails the build.

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Random hex token (>= 32 bytes) sent by Telegram in the secret_token header.
# Rotate with: wrangler secret put TELEGRAM_WEBHOOK_SECRET + Telegram setWebhook.
TELEGRAM_WEBHOOK_SECRET=
# Numeric Telegram user id of the owner. The only chat the bot serves.
TELEGRAM_OWNER_ID=

# --- AI providers -----------------------------------------------------------
# Groq: primary and secondary accounts. Slot 1 is tried first.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
# Gemini: parked unless GEMINI_ENABLED=1. Order is set by AI_PROVIDER_ORDER.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# --- Other integrations (optional) -----------------------------------------
# Serper.dev key for /lookup web results.
SERPER_API_KEY=
# Token that authorises the Google Drive backup export endpoint.
BACKUP_EXPORT_TOKEN=
# Optional uptime ping URL for cron health.
HEALTHCHECKS_PING_URL=

# --- Test-only routes (never enable in production) -------------------------
# ENABLE_TEST_ROUTES=1 exposes /api/v1/internal/*, and only together with a
# TEST_ADMIN_TOKEN of at least 32 characters. Both unset is the production state.
ENABLE_TEST_ROUTES=
TEST_ADMIN_TOKEN=
